<!-- Contact Section -->
<section class="py-24 bg-surface-container-low relative overflow-hidden" id="contact">
<!-- Decorative Background Element -->
<div class="absolute left-0 bottom-0 w-1/3 h-1/2 bg-gradient-to-tr from-primary/5 to-transparent -z-0"></div>
<div class="max-w-7xl mx-auto px-8 relative z-10">
<div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
<!-- Contact Info -->
<div>
<h2 class="font-headline font-extrabold text-3xl md:text-4xl text-on-surface tracking-tight mb-6">Initiate Your Project</h2>
<p class="text-on-surface-variant mb-12 max-w-md">Connect with our engineering team to discuss custom configurations, material specifications, or immediate procurement needs.</p>
<div class="space-y-8">
<div class="flex items-start gap-4">
<div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center flex-shrink-0 mt-1">
<span class="material-symbols-outlined text-secondary text-sm">location_on</span>
</div>
<div>
<h4 class="font-headline font-bold text-on-surface text-lg">Headquarters</h4>
<p class="text-sm text-on-surface-variant mt-1">Industrial Park Zona Norte<br/>Building 4, Sector B<br/>Monterrey, NL</p>
</div>
</div>
<div class="flex items-start gap-4">
<div class="w-10 h-10 rounded-full bg-secondary/10 flex items-center justify-center flex-shrink-0 mt-1">
<span class="material-symbols-outlined text-secondary text-sm">mail</span>
</div>
<div>
<h4 class="font-headline font-bold text-on-surface text-lg">Direct Contact</h4>
<p class="text-sm text-on-surface-variant mt-1">sales@rotonac.com<br/>engineering@rotonac.com</p>
</div>
</div>
</div>
</div>
<!-- Contact Form -->
<div class="bg-surface-container-lowest rounded-3xl p-8 md:p-10 ambient-shadow inner-glow">
<form class="space-y-6">
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<div class="ghost-border pb-2 group">
<label class="block text-xs font-semibold text-on-surface-variant mb-2 uppercase tracking-wider group-focus-within:text-secondary transition-colors">Full Name</label>
<input class="w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 text-sm" placeholder="John Doe" type="text"/>
</div>
<div class="ghost-border pb-2 group">
<label class="block text-xs font-semibold text-on-surface-variant mb-2 uppercase tracking-wider group-focus-within:text-secondary transition-colors">Email Address</label>
<input class="w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 text-sm" placeholder="john@company.com" type="email"/>
</div>
</div>
<div class="ghost-border pb-2 group">
<label class="block text-xs font-semibold text-on-surface-variant mb-2 uppercase tracking-wider group-focus-within:text-secondary transition-colors">Interested In</label>
<select class="w-full bg-transparent border-none p-0 text-on-surface focus:ring-0 text-sm cursor-pointer appearance-none">
<option disabled="" selected="" value="">Select an option</option>
<option value="residential">Residential Tanks</option>
<option value="industrial">Industrial Storage</option>
